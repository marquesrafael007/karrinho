{
  "expo": {
    "name": "karrinho",
    "slug": "karrinho",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "karrinho",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F8F6",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.rafaelmarques.karrinho",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      ["expo-navigation-bar", { "enforceContrast": false }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/expo.icon/Assets/grid.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F6",
          "dark": { "backgroundColor": "#121814" }
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e562bc6-98d9-4f7b-b423-47f63ae430fc"
      }
    }
  }
}
