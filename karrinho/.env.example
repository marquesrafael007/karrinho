# Set this to your Node server's HTTPS URL before building an APK.
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
# Leave empty for local development: Expo Go uses the Metro host on port 3001;
# web uses the Expo API routes on the same origin. Run `npm run dev`.
# If overriding for phone testing, use the computer's CURRENT LAN IP, not localhost.

# Server only — NEVER use an EXPO_PUBLIC_ prefix for the Firecrawl key.
# auto: Firecrawl when a key exists; otherwise the existing Cheerio/Playwright scraper.
# firecrawl: require a key and report errors without silently switching providers.
# legacy: explicitly use the existing scraper.
SCRAPING_PROVIDER=auto
FIRECRAWL_API_KEY=
